---
// Author/reviewer bio pages. Generates one page per entry in src/lib/authors.ts.
// Scaffolding: only "equipo-ocl" exists today (a placeholder team entity, not a
// fabricated named person). Add real authors to authors.ts as they're designated.
import Shell from "../../layouts/Shell.astro";
import { AUTHORS } from "../../lib/authors";

export function getStaticPaths() {
  return Object.values(AUTHORS).map((author) => ({
    params: { slug: author.slug },
    props: { author },
  }));
}

const { author } = Astro.props;
const canonical = `https://onlinecasinolatino.com/autor/${author.slug}/`;

const personSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": author.schemaType,
  name: author.name,
  url: canonical,
  description: author.bio,
  ...(author.photo ? { image: author.photo } : {}),
  ...(author.linkedin ? { sameAs: [author.linkedin] } : {}),
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://onlinecasinolatino.com/" },
    { "@type": "ListItem", position: 2, name: author.name, item: canonical },
  ],
});

const head = `<meta name="robots" content="index, follow" />
<title>${author.name} | Online Casino Latino</title>
<meta name="description" content="${author.bio}" />
<link rel="canonical" href="${canonical}" />
<script type="application/ld+json">${personSchema}</script>
<script type="application/ld+json">${breadcrumbSchema}</script>`;

const body = `
<div class="topbar"><div class="container">
